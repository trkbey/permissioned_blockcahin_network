# copy .env.example .env  and fill this line
PORT=3000

DATABASE_URL=postgresql://appuser:BURAYA_GUCLU_PAROLA@postgres_db:5432/appdb

RPC_URL=http://validator1:8545

#Same as contract/npm run genkey 

PRIVATE_KEY=

CONTRACT_ADDRESS=

# --- API security ---
# Format: name:role:key[,name:role:key...]
#
#   name     hash_anchors.created_by field is written as "api:<name>"
# role reader | writer (writer can do everything reader can do)
# key must be at least 32 characters; client sends it in the X-API-Key header
#
# Record addition (POST /api/records/...) is only available for the writer role.
# At least one writer must be defined, otherwise the service will not start.
#
# To generate a key:
# node -e "console.log(require('crypto').Randomytes(32).toString('hex'))"
API_KEYS=dashboard:writer:HEX_HERE,audit:reader:ANOTHER_HEX_HERE

# --- Session (user login) ---
# Secret key that signs the session token. Minimum 32 characters.
# When changed, all active sessions are terminated.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false

# --- Initial users ---
# ONLY used when the users table is empty; existing accounts are never overwritten.
# Passwords must be at least 12 characters.
# You can delete these lines after the first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ad12345678
SEED_VIEWER_USERNAME=viewer
SEED_VIEWER_PASSWORD=vw12345678

CORS_ORIGIN=http://localhost:8080
ALLOW_AUDIT_RESET=false
